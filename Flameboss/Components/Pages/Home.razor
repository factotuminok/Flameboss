@page "/"
@inject FlameBossService FlameBoss
@inject ILogger<Home> Logger
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>Flameboss 400 Controller</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Flameboss 400 controller</MudText>
<MudGrid Spacing="2">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.caption">Pit Temperature</MudText>
            <MudText Typo="Typo.h5">@_currentStatus.Pit</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.caption">Meat Temperature</MudText>
            <MudText Typo="Typo.h5">@_currentStatus.Meat1</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.caption">Blower Speed</MudText>
            <MudText Typo="Typo.h5">@_currentStatus.BlowerPercentage</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.caption">Set Temperature</MudText>
            <MudText Typo="Typo.h5">@_currentStatus.SetTemperature</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Thermostat"
                       OnClick="SetTemperature_Callback">Set Temperature</MudButton>
            @* Filled orange flame = cook running; outlined grey flame = not running. Re-read on every render (5 s timer + clicks). *@
            <MudTooltip Text="@(FlamebossData.Cooking ? "Cook running: click to stop" : "Cook not running: click to start")">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@(FlamebossData.Cooking ? Icons.Material.Filled.LocalFireDepartment : Icons.Material.Outlined.LocalFireDepartment)"
                           IconColor="@(FlamebossData.Cooking ? Color.Warning : Color.Default)"
                           aria-label="@(FlamebossData.Cooking ? "Toggle cook (running)" : "Toggle cook (not running)")"
                           OnClick="ToggleCook_Callback">Toggle Cook</MudButton>
            </MudTooltip>
        </MudStack>
    </MudItem>
    <MudItem xs="12" lg="6">
        <MudPaper Class="pa-2" Elevation="1">
            <MudTimeSeriesChart ChartSeries="@_tempSeries"
                                @bind-SelectedIndex="_index"
                                Width="100%"
                                Height="@ChartHeight"
                                ChartOptions="@_tempOptions"
                                AxisChartOptions="@_axisChartOptions"
                                CanHideSeries="true"
                                TimeLabelSpacing="TimeSpan.FromMinutes(5)"
                                TimeLabelSpacingRounding="_roundedLabelSpacing"
                                TimeLabelSpacingRoundingPadSeries="_roundedLabelSpacingPadSeries"
                                DataMarkerTooltipTimeLabelFormat="HH:mm:ss"/>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="6">
        <MudPaper Class="pa-2" Elevation="1">
            <MudTimeSeriesChart ChartSeries="@_blowerSeries"
                                @bind-SelectedIndex="_index"
                                Width="100%"
                                Height="@ChartHeight"
                                ChartOptions="@_blowerOptions"
                                AxisChartOptions="@_axisChartOptions"
                                CanHideSeries="true"
                                TimeLabelSpacing="TimeSpan.FromMinutes(5)"
                                TimeLabelSpacingRounding="_roundedLabelSpacing"
                                TimeLabelSpacingRoundingPadSeries="_roundedLabelSpacingPadSeries"
                                DataMarkerTooltipTimeLabelFormat="HH:mm:ss"/>
        </MudPaper>
    </MudItem>
</MudGrid>

@code{
    private PeriodicTimer? periodicTimer;
    private CancellationTokenSource cts = new();
    private int _index = -1;

    private ChartOptions _tempOptions = new ChartOptions
    {
        YAxisLines = false,
        YAxisTicks = 50,
        MaxNumYAxisTicks = 8,
        YAxisRequireZeroPoint = true,
        XAxisLines = false,
        LineStrokeWidth = 1,
    };

    private ChartOptions _blowerOptions = new ChartOptions
    {
        YAxisLines = false,
        YAxisTicks = 10,
        MaxNumYAxisTicks = 10,
        YAxisRequireZeroPoint = true,
        XAxisLines = false,
        LineStrokeWidth = 1,
    };

    private AxisChartOptions _axisChartOptions = new()
    {
        XAxisLabelRotation = 90,
        // Redraw to the container's size so the charts follow the window width.
        MatchBoundsToSize = true
    };

    private TimeSeriesChartSeries _pitData = new();
    private TimeSeriesChartSeries _meatData = new();
    private TimeSeriesChartSeries _setData = new();
    private TimeSeriesChartSeries _blowerData = new();

    private List<TimeSeriesChartSeries> _tempSeries = new();
    private List<TimeSeriesChartSeries> _blowerSeries = new();
    private FlameBossStatus _currentStatus;

    private bool _roundedLabelSpacing = false;
    private bool _roundedLabelSpacingPadSeries = false;

    // Scales with the viewport height, within bounds that stay readable on phones and desktops.
    private const string ChartHeight = "clamp(220px, 40vh, 380px)";

    protected override async void OnInitialized()
    {
        _currentStatus = FlamebossData.CurrentStatus;
        periodicTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        while (await periodicTimer.WaitForNextTickAsync(cts.Token))
        {
            _tempSeries.Clear();
            _blowerSeries.Clear();
            _currentStatus = FlamebossData.CurrentStatus;
            
            var now = DateTime.Now;
            List<TimeSeriesChartSeries.TimeValue> pitData = FlamebossData.GetLastUpdateList()
                .Zip(FlamebossData.GetPitTemperatureList(), (dateTime, value) => new TimeSeriesChartSeries.TimeValue
                    (dateTime, value)).ToList();
            _pitData = new TimeSeriesChartSeries
            {
                Index = 0,
                Name = "Pit",
                Data = pitData,
                IsVisible = true,
                LineDisplayType = LineDisplayType.Line,
                DataMarkerTooltipTitleFormat = "{{X_VALUE}}",
                DataMarkerTooltipSubtitleFormat = "{{Y_VALUE}}",
                ShowDataMarkers = false
            };

            List<TimeSeriesChartSeries.TimeValue> meatData = FlamebossData.GetLastUpdateList()
                .Zip(FlamebossData.GetMeatTemperatureList(), (dateTime, value) => new TimeSeriesChartSeries.TimeValue
                    (dateTime, value)).ToList();
            _meatData = new TimeSeriesChartSeries
            {
                Index = 1,
                Name = "Meat",
                Data = meatData,
                IsVisible = true,
                LineDisplayType = LineDisplayType.Line,
                DataMarkerTooltipTitleFormat = "{{X_VALUE}}",
                DataMarkerTooltipSubtitleFormat = "{{Y_VALUE}}",
                ShowDataMarkers = false
            };

            List<TimeSeriesChartSeries.TimeValue> setData = FlamebossData.GetLastUpdateList()
                .Zip(FlamebossData.GetSetTemperatureList(), (dateTime, value) => new TimeSeriesChartSeries.TimeValue
                    (dateTime, value)).ToList();
            _setData = new TimeSeriesChartSeries
            {
                Index = 2,
                Name = "Set",
                Data = setData,
                IsVisible = true,
                LineDisplayType = LineDisplayType.Line,
                DataMarkerTooltipTitleFormat = "{{X_VALUE}}",
                DataMarkerTooltipSubtitleFormat = "{{Y_VALUE}}",
                ShowDataMarkers = false
            };

            _tempSeries.Add(_pitData);
            _tempSeries.Add(_meatData);
            _tempSeries.Add(_setData);

            List<TimeSeriesChartSeries.TimeValue> blowerData = FlamebossData.GetLastUpdateList()
                .Zip(FlamebossData.GetBlowerSpeedList(), (dateTime, value) => new TimeSeriesChartSeries.TimeValue
                    (dateTime, value)).ToList();
            _blowerData = new TimeSeriesChartSeries
            {
                Index = 0,
                Name = "Blower",
                Data = blowerData,
                IsVisible = true,
                LineDisplayType = LineDisplayType.Area,
                DataMarkerTooltipTitleFormat = "{{X_VALUE}}",
                DataMarkerTooltipSubtitleFormat = "{{Y_VALUE}}",
                ShowDataMarkers = false
            };

            _blowerSeries.Add(_blowerData);

            StateHasChanged();
        }
    }

    private async Task ToggleCook_Callback(MouseEventArgs obj)
    {
        try
        {
            await FlameBoss.ToggleCook();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Toggle cook failed");
        }
    }

    private async Task SetTemperature_Callback(MouseEventArgs obj)
    {
        var initial = Math.Clamp(_currentStatus.SetTemperature == 0 ? 225 : _currentStatus.SetTemperature,
            SetTemperatureDialog.MinTemperature, SetTemperatureDialog.MaxTemperature);
        var parameters = new DialogParameters<SetTemperatureDialog> { { x => x.Temperature, initial } };
        var dialog = await DialogService.ShowAsync<SetTemperatureDialog>("Set Temperature", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: int temperature })
            return;

        try
        {
            var response = await FlameBoss.SetTemperature(temperature);
            Snackbar.Add(response.Message, Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Set temperature to {Temperature} failed", temperature);
            Snackbar.Add($"Failed to set temperature: {ex.Message}", Severity.Error);
            return;
        }

        // Re-read the controller so the Set Temperature display reflects the change right away.
        try
        {
            _currentStatus = await FlameBoss.GetStatus();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Status refresh after setting temperature failed");
        }
    }

}